# Build-time settings; no secrets. Never add NEXT_PUBLIC_ prefixes.
# Keep false locally and in Cloudflare Preview. Set true in Production only
# after the custom domain is ready, then redeploy.
ALLOW_INDEXING=false
# Must match the Cloudflare Pages production branch. Other Pages branches
# always render noindex, even if ALLOW_INDEXING was accidentally set to true.
PRODUCTION_BRANCH=main
